<?xml version="1.0" encoding="utf-8"?>
<!-- The splash on Android 8 to 11, which have no system splash screen: the
     same picture Android 12+ draws (values-v31/styles.xml), the egg in a
     160 dp grey circle on the theme's ground (spec §9.7). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tomo_ground" />
    <item
        android:width="160dp"
        android:height="160dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/tomo_icon_grey" />
        </shape>
    </item>
    <item
        android:width="240dp"
        android:height="240dp"
        android:drawable="@drawable/splash_egg"
        android:gravity="center" />
</layer-list>
