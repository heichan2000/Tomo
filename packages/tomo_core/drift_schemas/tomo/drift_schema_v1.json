  "fixed_sql": [
    {
      "name": "projects",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"projects\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "tasks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"project_id\" INTEGER NOT NULL REFERENCES projects (id) ON DELETE CASCADE, \"title\" TEXT NOT NULL, \"notes\" TEXT NULL, \"status\" TEXT NOT NULL DEFAULT 'todo', \"estimated_pomodoros\" INTEGER NULL, \"actual_pomodoros\" INTEGER NOT NULL DEFAULT 0, \"cumulative_focus_minutes\" INTEGER NOT NULL DEFAULT 0, \"estimate_prompted_at\" INTEGER NULL, \"completion_bonus_granted_at\" INTEGER NULL, \"created_at\" INTEGER NOT NULL, \"last_focused_at\" INTEGER NULL, \"completed_at\" INTEGER NULL);"
        }
      ]
    },
    {
      "name": "pets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pets\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"species\" TEXT NOT NULL, \"name\" TEXT NULL, \"hatched_at\" INTEGER NULL, \"exp\" INTEGER NOT NULL DEFAULT 0, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "block_records",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"block_records\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"pet_id\" INTEGER NOT NULL REFERENCES pets (id), \"task_id\" INTEGER NULL REFERENCES tasks (id) ON DELETE SET NULL, \"project_id\" INTEGER NULL REFERENCES projects (id) ON DELETE SET NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NOT NULL, \"minutes\" INTEGER NOT NULL, \"local_date\" TEXT NOT NULL, \"utc_offset_minutes\" INTEGER NOT NULL, \"exp_granted\" INTEGER NOT NULL, \"pet_exp_after\" INTEGER NOT NULL, \"settled_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "focus_cycle",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"focus_cycle\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"task_id\" INTEGER NOT NULL REFERENCES tasks (id) ON DELETE RESTRICT, \"start_at\" INTEGER NOT NULL, \"end_at\" INTEGER NOT NULL, \"focus_minutes\" INTEGER NOT NULL, \"break_minutes\" INTEGER NOT NULL, \"auto_start\" INTEGER NOT NULL CHECK (\"auto_start\" IN (0, 1)), \"break_start_at\" INTEGER NULL, \"break_skipped_at\" INTEGER NULL, \"block_record_id\" INTEGER NULL REFERENCES block_records (id), \"seen_at\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (id = 1));"
        }
      ]
    },
